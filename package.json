{
  "name": "couple-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "server": "node server/index.js",
    "build": "tsc && node -e \"require('fs').rm('dist',{recursive:true,force:true},()=>{})\" && (vite build || vite build || vite build || vite build || vite build)",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sb": "node --env-file=.env scripts/with-env.mjs supabase",
    "sb:admin": "node --env-file=.env scripts/supabase-admin.mjs",
    "smoke": "node --env-file=.env scripts/smoke-supabase.mjs",
    "migrate": "node --env-file=.env scripts/migrate-to-supabase.mjs",
    "deploy": "npm run build && node --env-file=.env scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "supabase": "^2.119.0",
    "supertest": "^7.3.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.8",
    "wrangler": "^4.147.0"
  }
}
